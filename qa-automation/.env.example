# Mobile app under test
EXPO_URL=http://localhost:8081
BACKEND_URL=http://localhost:5000
APK_PATH=./build/dental-ai-dev-client.apk
APP_PACKAGE=com.samiksha08.app
APP_ACTIVITY=.MainActivity

# Supabase (use a dedicated test project / anon key — never production data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Appium / device targeting
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
DEVICE_NAME=emulator-5554
PLATFORM_VERSION=14
AUTOMATION_NAME=UiAutomator2

# Test identities (create these users in the Supabase test project beforehand)
TEST_USER_EMAIL=qa.doctor@example.com
TEST_USER_PASSWORD=TestPassword123!
TEST_USER_INVALID_PASSWORD=wrong-password

# Reporting
REPORT_ENV_LABEL=CI
